# 배포된 사이트 주소 (Vercel 무료 서브도메인 또는 커스텀 도메인)
NEXT_PUBLIC_SITE_URL=https://calcmoa.vercel.app

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX) - 없으면 GA 스크립트가 삽입되지 않음
NEXT_PUBLIC_GA_ID=

# 애드센스 승인 후 발급받는 게시자 ID (예: ca-pub-XXXXXXXXXXXXXXXX)
# 자동 광고(Auto ads) 방식 사용 - 클라이언트 ID만 있으면 Google이 광고 위치를 자동 배치함
# 비어있으면 광고 스크립트 자체가 삽입되지 않음
NEXT_PUBLIC_ADSENSE_CLIENT=

# Upstash Redis(Marketplace) 연결 문자열 - 인형뽑기 게임의 방 상태/실시간 메시지 브로커로 사용
# `vercel integration add upstash` 실행 후 `vercel env pull`로 자동 채워짐 (직접 입력하지 마세요)
REDIS_URL=
