# 배포된 사이트 주소 (Vercel 무료 서브도메인 또는 커스텀 도메인)
NEXT_PUBLIC_SITE_URL=https://calcmoa.vercel.app

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX) - 없으면 GA 스크립트가 삽입되지 않음
NEXT_PUBLIC_GA_ID=

# 애드센스 승인 후 발급받는 게시자 ID (예: ca-pub-XXXXXXXXXXXXXXXX)
# 비어있으면 각 페이지에 플레이스홀더만 표시되고 실제 광고는 로드되지 않음
NEXT_PUBLIC_ADSENSE_CLIENT=

# 계산기별 광고 슬롯 ID (애드센스에서 광고 단위 생성 후 발급). 슬러그의 -는 _로, 대문자로 치환.
# 예: /income-tax 페이지의 두 번째 광고 슬롯 -> NEXT_PUBLIC_ADSENSE_SLOT_INCOME_TAX_2
NEXT_PUBLIC_ADSENSE_SLOT_SALARY_1=
NEXT_PUBLIC_ADSENSE_SLOT_SALARY_2=
NEXT_PUBLIC_ADSENSE_SLOT_SEVERANCE_1=
NEXT_PUBLIC_ADSENSE_SLOT_SEVERANCE_2=
NEXT_PUBLIC_ADSENSE_SLOT_LOAN_1=
NEXT_PUBLIC_ADSENSE_SLOT_LOAN_2=
NEXT_PUBLIC_ADSENSE_SLOT_AGE_1=
NEXT_PUBLIC_ADSENSE_SLOT_AGE_2=
NEXT_PUBLIC_ADSENSE_SLOT_INCOME_TAX_1=
NEXT_PUBLIC_ADSENSE_SLOT_INCOME_TAX_2=
NEXT_PUBLIC_ADSENSE_SLOT_VAT_1=
NEXT_PUBLIC_ADSENSE_SLOT_VAT_2=
